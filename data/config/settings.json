	# Cargo icons beyond the twenty registered above need no registry entries:
	# special_items.csv references each icon file by PATH directly.

	# ============================================================
	# Acquisition (the LunaSettings.csv rows
	# mirror the five player-tunable knobs, these values as the
	# no-LunaLib defaults).
	# ============================================================

	# Market stock: per-submarket carry chance at size 5, scaled
	# by size: clamp(1 + step * (size-5), min, max). One
	# furnishing per market at a time; exceptionals never appear
	# in markets.
	"cq_market_chance": 0.60,
	"cq_market_size_step": 0.10,
	"cq_market_size_min": 0.70,
	"cq_market_size_max": 1.30,

	# Scavenging: chance that a special location holds one
	# furnishing among its salvage; attached as DropData to
	# discovered entities of these types.
	"cq_salvage_chance": 0.50,
	"cq_salvage_entity_types": [
		"station_research",
		"station_research_remnant",
		"station_mining",
		"station_mining_remnant",
		"orbital_habitat",
	],

	# Post-battle salvage: chance = min(1, destroyed enemy
	# fleet points * per_fp); per_fp is 1/105, so a 105 FP
	# battle (a capital, 2 cruisers, 3 destroyers, 4
	# frigates) reaches CERTAINTY and the curve saturates there.
	# There is no cap key and no owned-weight dampening
	# key: acquisition is collection-aware in every channel
	# (owned picks substitute to an unowned same-rarity item;
	# an exhausted rarity drops nothing).
	"cq_battle_chance_per_fp": 0.00952381,

	# Rarity weights, applied inside every channel pool.
	"cq_rarity_weight_common": 1.0,
	"cq_rarity_weight_uncommon": 0.55,
	"cq_rarity_weight_rare": 0.30,
	"cq_rarity_weight_exceptional": 0.12,

	# ============================================================
	# Slot economy: you
	# start with the initial count and buy one slot per ladder
	# step, in order, to the max. Cumulative
	# 8,885,000 for all ten.
	# LunaLib mirrors each step as cq_slot_price_1 to _10.
	# ============================================================
	"cq_slot_initial_count": 5,
	"cq_slot_max_count": 15,
	"cq_slot_prices": [5000, 10000, 20000, 50000, 100000, 200000, 500000, 1000000, 2000000, 5000000],

	# ============================================================
	# Sticker scale:
	# +/- steps a placed sticker's scale; min/max are the binding
	# bounds. Placement is center-in-image; overhang crops at the
	# image edge. Cosmetic only; effects
	# never change with size.
	# ============================================================
	"cq_sticker_scale_step": 0.10,
	"cq_sticker_scale_min": 0.5,
	"cq_sticker_scale_max": 2.0,

	# Sticker rotation: degrees per CW/CCW press; 30 = 12
	# steps per circle. The model persists the
	# STEP COUNT, normalized into one circle; flip needs no key.
	# (There is no carry key: the Move button carries
	# the lift verb on the vanilla shortcut convention, so no key
	# name ships anywhere.)
	"cq_rotate_step_degrees": 30,

	# Decorative slots: dupes allowed, ZERO effect
	# participation, always the front z-band. Bought flat,
	# cq_decorative_slot_price each, up to the cap (all twenty
	# cost 200,000, about 2.3% of the effect ladder).
	"cq_decorative_slot_max": 20,
	"cq_decorative_slot_price": 10000,

	# ============================================================
	# Difficulty: ONE global
	# effect multiplier over every furnishing effect; catalog
	# magnitudes stay Normal-canonical (the 1.0x base) and every
	# display shows the effective value.
	# Auto is the default: Survival in a Survival Mode game, Normal
	# otherwise. LunaLib Radio cq_difficulty overrides the
	# default live; an absent or unknown value reads Auto.
	# ============================================================
	"cq_difficulty_default": "auto",
	"cq_difficulty_effect_mult_survival": 0.5,
	"cq_difficulty_effect_mult_normal": 1.0,
	"cq_difficulty_effect_mult_story": 2.0,

	# Defaults for the LunaLib checkboxes of the same keys, read when LunaLib is not installed.
	"cq_mgmt_intel_only": false,
	"cq_survival_finds": true,

	# ============================================================
	# Per-item magnitudes.
	#
	# Key scheme: item id cq_<slug> takes cq_item_<slug>_mag; the
	# one dual-effect item adds _mag2. For a capped effect
	# _mag is the CAP (fuel
	# or supplies, credits of tariff refunded a month, crew or marines per
	# battle or raid), and the item carries its percentage in
	# _pct. The occasion a furnishing pays on is not a number
	# here: it is the when and arg cells of its row in
	# data/config/cq/cq_furnishings.csv, and the difficulty
	# setting never scales it.
	# ============================================================

	# Bunk (the piloted ship, on an occasion inside a battle)
	"cq_item_berth_pad_mag": 7,         # +7% top speed for the first 60 seconds of battle
	"cq_item_gel_mattress_mag": 12,     # -12% armor damage taken in a battle against a larger enemy force
	"cq_item_officers_rack_mag": 7,     # -7% damage taken by shields in a battle against a larger enemy force
	"cq_item_cryofoam_bunk_mag": 5,     # time passes 5% faster for the first 60 seconds of battle
	"cq_item_ease_field_berth_mag": 7,  # +7% ballistic and energy weapon range once peak operating time has run out

	# Wall art (a share of the tariffs paid at one group of markets is refunded as credits;
	# the tariff itself is not lowered; _mag is the cap in credits a month)
	"cq_item_recruitment_print_mag": 2000, # cap: up to 2,000 credits a month
	"cq_item_recruitment_print_pct": 25,   # 25% of tariffs paid at independent markets are refunded
	"cq_item_path_triptych_mag": 2000,     # cap: up to 2,000 credits a month
	"cq_item_path_triptych_pct": 40,       # 40% of tariffs paid at markets with a Luddic majority are refunded
	"cq_item_kill_marks_mag": 3000,        # cap: up to 3,000 credits a month
	"cq_item_kill_marks_pct": 25,          # 25% of tariffs paid at markets with a military base are refunded
	"cq_item_warlord_banner_mag": 4000,    # cap: up to 4,000 credits a month
	"cq_item_warlord_banner_pct": 40,      # 40% of tariffs paid at independent markets are refunded
	"cq_item_xiv_pennant_mag": 5000,       # cap: up to 5,000 credits a month
	"cq_item_xiv_pennant_pct": 50,         # 50% of tariffs paid at Hegemony markets are refunded

	# Pet (a fleet effect that applies all the time)
	"cq_item_hull_rat_cage_mag": 5,        # +5% post-battle salvage
	"cq_item_grav_cat_mag": 12,            # +12% repair rate outside of combat
	"cq_item_cyber_parrot_mag": 18,        # -18% combat readiness lost to star coronas and hyperspace storms
	"cq_item_agravifish_bowl_mag": 6,      # cap: up to 6 fuel per light-year
	"cq_item_agravifish_bowl_pct": 6,      # -6% fleet fuel use
	"cq_item_salvage_raven_mag": 6,        # +6% salvaged resources, rare items included

	# Plant (crew, marines and combat readiness returned after a battle or a raid;
	# for the returned kinds _mag is the cap in heads per battle or raid)
	"cq_item_herb_rack_mag": 48,           # cap: up to 48 crew per battle in hyperspace
	"cq_item_herb_rack_pct": 25,           # 25% of crew lost return to duty
	"cq_item_antixenol_planter_mag": 10,   # cap: up to 10 marines per raid
	"cq_item_antixenol_planter_pct": 12,   # 12% of marines lost in a raid return to duty
	"cq_item_prayer_garden_mag": 35,       # the piloted ship regains 35% of the combat readiness a battle cost it
	"cq_item_rose_bonsai_mag": 100,        # cap: up to 100 crew after a battle with none of your ships destroyed
	"cq_item_rose_bonsai_pct": 25,         # 25% of crew lost return to duty
	"cq_item_reef_terrarium_mag": 30,      # cap: up to 30 crew per battle
	"cq_item_reef_terrarium_pct": 25,      # 25% of crew lost return to duty

	# Desk (relationship with the contacts at a market docked at, or with its faction, every so many days)
	"cq_item_chart_table_mag": 2,     # +2 relationship with a faction every 90 days, on docking at one of its markets
	"cq_item_tripad_dock_mag": 4,     # +4 relationship with each contact every 30 days, on docking at their market
	"cq_item_ephemeris_mag": 1,       # +1 maximum contacts
	"cq_item_slate_rack_mag": 4,      # +4 relationship with each trade contact every 15 days, on docking at their market
	"cq_item_survey_cache_mag": 4,    # +4 relationship with each trade contact every 10 days, on docking at their market

	# Display case (the condition of recovered ships of one group)
	"cq_item_medal_rack_mag": 50,        # recovered ships of the Low Tech design type come with 50 supplies, at most once every 30 days
	"cq_item_sample_case_mag": 1,        # recovered destroyers have 1 fewer d-mod
	"cq_item_vambrace_fragment_mag": 1,  # recovered capital ships have 1 fewer d-mod
	"cq_item_warlord_sidearm_mag": 1,    # recovered civilian ships have 1 fewer d-mod
	"cq_item_remnant_facet_mag": 1,      # ships recovered from derelicts have 1 fewer d-mod

	# Rug (a fleet effect that follows how the fleet is travelling)
	"cq_item_deck_mat_mag": 10,            # cap: up to 10 fuel per light-year, while Sustained Burn is active
	"cq_item_deck_mat_pct": 10,            # -10% fleet fuel use
	"cq_item_insulfiber_carpet_mag": 12,   # -12% detected-at range while moving slowly
	"cq_item_kumari_rug_mag": 50,          # cap: up to 50 supplies a month, while Sustained Burn is active
	"cq_item_kumari_rug_pct": 25,          # -25% fleet supply use
	"cq_item_deck_quilt_mag": 37,          # -37% combat readiness lost to hyperspace storm strikes, per member
	"cq_item_ash_silk_rug_mag": 25,        # +25% repair rate outside of combat while moving slowly

	# Lighting (a fleet or piloted-ship effect that follows what the ship shows)
	"cq_item_lume_candles_mag": 50,  # cap: up to 50 supplies a month, in a star system with no market
	"cq_item_lume_candles_pct": 25,  # -25% fleet supply use
	"cq_item_glowpanel_mag": 12,     # -12% detected-at range for 2 days after docking
	"cq_item_desk_lamp_mag": 1,      # +1 command point in a battle fought in a star system with no market
	"cq_item_signal_lamp_mag": 7,    # +7% top speed, piloted, in a battle begun while Go Dark is active
	"cq_item_lumen_shard_mag": 12,   # +12% sensor range while the transponder is off

	# Galley nook (units of one commodity added to the hold at month end)
	"cq_item_caff_urn_mag": 40,            # +40 domestic goods each month
	"cq_item_prize_still_mag": 80,         # +80 fuel each month
	"cq_item_drinks_cabinet_mag": 30,      # +30 luxury goods each month
