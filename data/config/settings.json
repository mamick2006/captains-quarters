	# Cargo icons beyond the twenty registered above need no registry entries:
	# special_items.csv references each icon file by PATH directly.

	# ============================================================
	# Acquisition (the LunaSettings.csv rows
	# mirror the five player-tunable knobs, these values as the
	# no-LunaLib defaults).
	# ============================================================

	# Market stock: per-submarket carry chance at size 5, scaled
	# by size: clamp(1 + step * (size-5), min, max). One
	# furnishing per market at a time; exceptionals never appear
	# in markets.
	"cq_market_chance": 0.60,
	"cq_market_size_step": 0.10,
	"cq_market_size_min": 0.70,
	"cq_market_size_max": 1.30,

	# Scavenging: chance that a special location holds one
	# furnishing among its salvage; attached as DropData to
	# discovered entities of these types.
	"cq_salvage_chance": 0.30,
	"cq_salvage_entity_types": [
		"station_research",
		"station_research_remnant",
		"station_mining",
		"station_mining_remnant",
		"orbital_habitat",
	],

	# Post-battle salvage: chance = min(1, destroyed enemy
	# fleet points * per_fp); per_fp is 1/105, so the 105 FP
	# reference battle (a capital, 2 cruisers, 3 destroyers, 4
	# frigates) reaches CERTAINTY and the curve saturates there.
	# There is no cap key and no owned-weight dampening
	# key: acquisition is collection-aware in every channel
	# (owned picks substitute to an unowned same-rarity item;
	# an exhausted rarity drops nothing).
	"cq_battle_chance_per_fp": 0.00952381,

	# Rarity weights, applied inside every channel pool.
	"cq_rarity_weight_common": 1.0,
	"cq_rarity_weight_uncommon": 0.55,
	"cq_rarity_weight_rare": 0.30,
	"cq_rarity_weight_exceptional": 0.12,

	# ============================================================
	# Slot economy: you
	# start with the initial count and buy one slot per ladder
	# step, in order, to the max. Cumulative
	# 8,885,000 for all ten.
	# LunaLib mirrors each step as cq_slot_price_1 to _10.
	# ============================================================
	"cq_slot_initial_count": 5,
	"cq_slot_max_count": 15,
	"cq_slot_prices": [5000, 10000, 20000, 50000, 100000, 200000, 500000, 1000000, 2000000, 5000000],

	# ============================================================
	# Sticker scale:
	# +/- steps a placed sticker's scale; min/max are the binding
	# bounds. Placement is center-in-image; overhang crops at the
	# image edge. Cosmetic only; effects
	# never change with size.
	# ============================================================
	"cq_sticker_scale_step": 0.10,
	"cq_sticker_scale_min": 0.5,
	"cq_sticker_scale_max": 2.0,

	# Sticker rotation: degrees per CW/CCW press; 30 = 12
	# steps per circle. The model persists the
	# STEP COUNT, normalized into one circle; flip needs no key.
	# (There is no carry key: the Move button carries
	# the lift verb on the vanilla shortcut convention, so no key
	# name ships anywhere.)
	"cq_rotate_step_degrees": 30,

	# Decorative slots: dupes allowed, ZERO effect
	# participation, always the front z-band. Bought flat,
	# cq_decorative_slot_price each, up to the cap (all twenty
	# cost 200,000, about 2.3% of the effect ladder).
	"cq_decorative_slot_max": 20,
	"cq_decorative_slot_price": 10000,

	# ============================================================
	# Difficulty: ONE global
	# effect multiplier at the CqEffects choke point; catalog
	# magnitudes stay Default-canonical (the 1.0x base) and every
	# display shows the effective value through the same accessor.
	# Default is the default. LunaLib Radio cq_difficulty overrides the
	# default live; an absent or unknown value reads Default.
	# ============================================================
	"cq_difficulty_default": "default",
	"cq_difficulty_effect_mult_survival": 0.5,
	"cq_difficulty_effect_mult_default": 1.0,
	"cq_difficulty_effect_mult_story": 2.0,

	# ============================================================
	# Per-item magnitudes.
	#
	# Key scheme: item id cq_<slug> takes cq_item_<slug>_mag; the
	# two dual-effect items add _mag2. _mag holds the budget-
	# priced quantity (for capped supply/fuel furnishings that is
	# the monthly CAP); those capped items carry
	# their percentage rider in _pct (and _pct2), which sizes the
	# effect for small fleets while the cap holds the budget.
	# ============================================================

	# Bunk (peak operating time / CR decay / own weapon and wing recovery)
	"cq_item_berth_pad_mag": 15,        # +15 s peak operating time
	"cq_item_gel_mattress_mag": 5,      # -5% CR degradation after peak
	"cq_item_officers_rack_mag": 10,        # +10% chance to recover own weapons and wings
